# SUPABASE URL and API setup
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by account sync, team checks, and admin APIs.
# Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# GeoNames account username for the village/locality autocomplete
# (register free at geonames.org, then enable "free web services" on the
# account page). Server-only. While unset, the location picker falls back
# to manual village/city entry.
GEONAMES_USERNAME=

# Resend API key for registration confirmation-code emails. Server-only.
# This is separate from the Resend SMTP settings in the Supabase dashboard:
# those cover Auth emails (confirm signup, password reset) only, and cannot
# send application email. While unset, registration still succeeds and the
# code is shown on-screen — only the email is skipped.
RESEND_API_KEY=

# Sender for those emails. Must be on a domain verified in Resend — that is
# mail.nezabazipunjab.com, not the apex domain. Resend rejects a send from an
# unverified domain with a 403 and no email goes out.
# Defaults to "NezaBazi Punjab <no-reply@mail.nezabazipunjab.com>" when unset,
# which is the address the Supabase Auth emails already send from. Leave this
# unset unless you need a different sender.
RESEND_FROM_EMAIL=

# Local rehearsal only: when set to 1, /api/live/state?sample=1 returns the
# built-in sample scoring data so /live and the overlays can be previewed
# before the scoring tables exist. Never set this on Vercel.
SCORING_SAMPLE_MODE=
